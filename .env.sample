# All settings are optional — the defaults shown here are used if a
# variable (or this whole file) is missing.

# Container user, should match your host user so mounted folders have the
# right owner. setup.sh fills these in automatically from `id -u` / `id -g`.
USER_ID=1000
GROUP_ID=1000

# Host paths for persistent data (volume mounts)
MODEL_DIR=./models
OUTPUT_DIR=./outputs
EXT_DIR=./extensions
EMBEDDINGS_DIR=./embeddings
LOGS_DIR=./logs
CACHE_DIR=./cache
PIP_CACHE_DIR=./pip-cache

# --- AMD GPU (ROCm) variant only ---
# Compatibility override for consumer cards ROCm doesn't officially
# support. Uncomment and set if generation fails or crashes:
#   RX 6000 series (RDNA2): 10.3.0
#   RX 7000 series (RDNA3): 11.0.0
# HSA_OVERRIDE_GFX_VERSION=10.3.0
#
# Host group IDs that own /dev/kfd and /dev/dri.
# setup.sh fills these in automatically — no need to set them by hand.
# VIDEO_GID=44
# RENDER_GID=992
